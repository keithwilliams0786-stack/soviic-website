<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>You're on the list — Soviic</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0B1929;
      color: #F0F8FF;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
      text-align: center;
      padding: 24px;
    }

    .card {
      max-width: 520px;
      background: rgba(15,34,54,0.7);
      border: 1px solid rgba(34,211,238,0.2);
      border-radius: 16px;
      padding: 40px;
    }

    h1 {
      color: #22D3EE;
      margin-bottom: 12px;
    }

    p {
      color: #7CA3C0;
      line-height: 1.6;
    }

    a {
      display: inline-block;
      margin-top: 20px;
      color: #22D3EE;
      text-decoration: none;
    }
  </style>
</head>
<body>

  <div class="card">
    <h1>You're on the list 🎉</h1>
    <p>Thanks for joining the Soviic early access waitlist.</p>
    <p>We’ll email you at: <strong id="email"></strong></p>

    <a href="/">← Back to home</a>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    document.getElementById("email").textContent = params.get("email") || "your email";
  </script>

</body>
</html>
